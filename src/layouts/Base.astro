---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { ui, path, asset, type Lang } from '../i18n/ui';
import { site, whatsapp } from '../data/site';

interface Props {
  lang: Lang;
  page: '' | 'work' | 'about' | '404';
  title: string;
  description: string;
  image?: string;
}
const { lang, page, title, description, image } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'ar' : 'en';
const pageKey = page === '404' ? '' : page;
const origin = Astro.site ? Astro.site.origin : '';
const canonical = origin + path(lang, pageKey);
const ogImage = image ?? origin + asset('og.png');
const navItems = [
  { key: 'work', label: t.nav.work },
  { key: 'about', label: t.nav.about },
] as const;
const social = [
  site.instagram && ['Instagram', site.instagram],
  site.behance && ['Behance', site.behance],
  site.linkedin && ['LinkedIn', site.linkedin],
  whatsapp && ['WhatsApp', whatsapp],
].filter(Boolean) as [string, string][];

const person = `${origin}${path('en')}#hassan`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': person,
      name: site.fullName,
      jobTitle: 'Video Editor & Motion Designer',
      ...(site.email && { email: `mailto:${site.email}` }),
      ...(site.phoneHref && { telephone: `+${site.phoneHref}` }),
      url: origin + path('en'),
      image: ogImage,
      sameAs: social.map(([, href]) => href).filter((h) => !h.startsWith('https://wa.me')),
      homeLocation: { '@type': 'Place', name: 'Alexandria, Egypt' },
      address: { '@type': 'PostalAddress', addressLocality: 'Dubai', addressCountry: 'AE' },
      knowsAbout: ['Video editing', 'Motion graphics', 'Graphic design'],
      knowsLanguage: ['ar', 'en'],
    },
    {
      '@type': 'ProfessionalService',
      name: `${site.brand} — Video Editing, Motion Graphics & Design`,
      url: origin + path('en'),
      image: ogImage,
      areaServed: ['Dubai', 'United Arab Emirates', 'Egypt'],
      address: { '@type': 'PostalAddress', addressLocality: 'Dubai', addressCountry: 'AE' },
      founder: { '@id': person },
    },
  ],
};
---
<!doctype html>
<html lang={lang} dir={t.dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {origin && <link rel="canonical" href={canonical} />}
  {page !== '404' && <link rel="alternate" hreflang="en" href={origin + path('en', pageKey)} />}
  {page !== '404' && <link rel="alternate" hreflang="ar" href={origin + path('ar', pageKey)} />}
  {page !== '404' && <link rel="alternate" hreflang="x-default" href={origin + path('en', pageKey)} />}
  {origin && <link rel="sitemap" href={asset('sitemap-index.xml')} />}
  {page === '404' && <meta name="robots" content="noindex" />}
  <meta name="author" content={site.fullName} />
  <meta name="theme-color" content="#0b0b0d" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.brand} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {origin && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ar_AE'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
  <link rel="icon" href={asset('favicon-32.png')} sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alexandria:wght@200..900&family=JetBrains+Mono:wght@400;500&display=swap" />

  <script is:inline>
    try { if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light'; } catch (e) {}
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="site-header">
    <div class="wrap">
      <a class="logo" href={path(lang)} aria-label={site.brand}>
        <Logo />
        <span>{site.brand}</span>
      </a>
      <nav class="nav" id="nav" aria-label="Main">
        {navItems.map((n) => (
          <a href={path(lang, n.key)} aria-current={page === n.key ? 'page' : undefined}>{n.label}</a>
        ))}
        <a href={`${path(lang)}#contact`}>{t.nav.contact}</a>
      </nav>
      <div class="tools">
        <a class="tool" href={path(other, pageKey)} hreflang={other} lang={other}>{t.langSwitch}</a>
        <button class="tool" type="button" data-theme-toggle aria-label={t.themeLight} data-label-dark={t.themeDark} data-label-light={t.themeLight}>
          <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg>
          <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <button class="tool menu-btn" type="button" aria-expanded="false" aria-controls="nav" data-menu>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
          <span class="visually-hidden">{t.menu}</span>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <span class="mono">© {new Date().getFullYear()} {site.fullName} · {t.footerLine}</span>
      <nav class="mono" aria-label="Footer">
        {social.map(([label, href]) => <a href={href} target="_blank" rel="noopener">{label}</a>)}
        {site.email && <a href={`mailto:${site.email}`}>Email</a>}
        {site.cv && <a href={site.cv} target="_blank" rel="noopener">CV</a>}
      </nav>
    </div>
  </footer>

  <!-- Page scrubber: the whole page as a clip, with section markers. Desktop only. -->
  <div class="scrub" dir="ltr" aria-hidden="true" data-scrub>
    <span class="scrub-tc mono" data-scrub-tc>00:00:00:00</span>
    <div class="scrub-lane" data-scrub-lane><span class="scrub-fill" data-scrub-fill></span><span class="scrub-head" data-scrub-head></span></div>
  </div>

  <dialog id="lightbox" aria-label="Image viewer">
    <div class="lb">
      <div class="lb-bar"><span class="mono" data-lb-count></span><button class="icon-btn" type="button" data-close>{t.close} ✕</button></div>
      <div class="lb-stage" data-lb-stage></div>
      <div class="lb-bar">
        <button class="icon-btn" type="button" data-lb-prev>{t.prev}</button>
        <span class="mono" data-lb-cap></span>
        <button class="icon-btn" type="button" data-lb-next>{t.next}</button>
      </div>
    </div>
  </dialog>
  <dialog id="player" aria-label="Video player">
    <div class="lb">
      <div class="lb-bar"><span class="mono" data-vp-title></span><button class="icon-btn" type="button" data-close>{t.close} ✕</button></div>
      <div class="lb-stage"><div class="video-stage" data-vp-stage></div></div>
      <div class="lb-bar"><span></span><a class="icon-btn" data-vp-link target="_blank" rel="noopener">{t.openDrive}</a></div>
    </div>
  </dialog>
  <div class="cursor" aria-hidden="true"></div>

  <script>
    import '../scripts/main';
  </script>
</body>
</html>

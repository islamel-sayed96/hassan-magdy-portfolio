# Hostinger's "Deploy from GitHub" copies this repo into public_html as-is and
# can't run a build. The built site lives in dist/, so serve every request
# from there. dist/ is rebuilt and committed by .github/workflows/build.yml.
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # /about -> /about/ when it's a page folder in dist/
    RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
    RewriteRule ^(?!dist/)(.+[^/])$ /$1/ [R=301,L]

    # Everything else is read from dist/
    RewriteRule ^(?!dist/)(.*)$ dist/$1 [L]
</IfModule>
